# One mark per outcome, sharing the single-character vocabulary aoe-github paints
# on its session rows (its uistate module's `_REVIEW_GLYPH`,
# `_YOUR_REVIEW_GLYPH`, `_CHECK_GLYPH`, `_PR_GLYPH`, `_DRAFT_GLYPH`,
# `_CONFLICT_GLYPH`, `_COMMENT_GLYPH`, `_QUEUE_GLYPH`, `_ERROR_GLYPH`): light
# marks name a review position (✓ approved, ✗ changes requested, ❝ commented,
# ⧗ awaiting review, ↻ pushed since review, ◷ partially approved), heavy ones
# name CI (✔ passing, ✘ failing, ~ running, ⇨ queued, ? unknown), and the PR
# facts keep their own (⇄ open, ◌ draft, ⊘ merge conflict, ⇉ in merge queue, ✉
# unresolved comments).
#
# ◉ is the request *on you*: someone else asked for your review, the rung that
# plugin draws as an eye and ranks above CI and comments because it is the one
# signal you can clear yourself. It shares no mark with feedback you owe a reply
# to (✉ unresolved) or with a review that merely landed (❝), so "they want my
# review" reads apart from "a review arrived".
#
# ⚑ (notification) and ◍ (assigned or in progress) are attention-only marks for
# states that plugin has no equivalent for. Every mark is one East-Asian-Neutral
# cell -- never the Ambiguous ●/○/▲ this table used to hold, which cost two
# columns in a CJK locale. No two distinct outcomes share a mark; synonyms do so
# on purpose (✓ covers ready/approved/merge ready/done/merged, ⧗ the waiting
# values, ✗ changes/blocked/overdue), because a mark names the outcome, not the
# word a source chose for it.
_INDICATOR_GLYPHS = {
    "approved": "✓", "ready": "✓", "merge ready": "✓", "completed": "✓",
    "done": "✓", "past": "✓", "merged": "✓",
    "partial": "◷", "partially approved": "◷",
    "changes": "✗", "changes requested": "✗", "blocked": "✗", "overdue": "✗",
    "changes pushed": "↻", "pushed since review": "↻",
    "commented": "❝", "review update": "❝",
    # "awaiting your review" is the exact status the plugin sends for a request on
    # the viewer (its rank-4 rung), so it belongs on the eye. Plain "awaiting
    # review" and "in review" mean waiting on someone else and stay on ⧗.
    "review requested": "◉", "requested": "◉", "awaiting your review": "◉",
    "reply needed": "✉",
    "notified": "⚑",
    "waiting": "⧗", "awaiting review": "⧗",
    "in review": "⧗", "today": "⧗", "due": "⧗", "soon": "⧗",
    "scheduled": "⧗", "upcoming": "⧗",
    "success": "✔", "passed": "✔", "failed": "✘", "ci failing": "✘",
    "running": "~", "now": "~", "queued": "⇨",
    "none": "?", "unknown": "?", "error": "!", "fetch failed": "!",
    "conflict": "⊘", "merge conflict": "⊘",
    "queue": "⇉",
    "draft": "◌", "yes": "◌", "wip": "◌", "todo": "◌", "backlog": "◌",
    "open": "⇄", "no": "⇄", "triage": "⇄",
    "assigned": "◍", "in progress": "◍", "active": "◍",
}


def _display_indicator(key, value):
    if key not in {"state", "ci", "draft", "review", "merge", "due"} or value == "—":
        return value
    if value in {
        "✓", "✔", "✗", "✘", "◷", "↻", "❝", "⧗", "◉", "⊘", "◌", "⇄",
        "⇉", "~", "⇨", "?", "✉", "!", "⚑", "◍",
    }:
        return value
    return _INDICATOR_GLYPHS.get(value.casefold(), "?")
_INDICATOR_ORDER = tuple(_INDICATOR_LABELS)


def _indicator_columns(items, columns):
    if columns is not None:
        return columns
    found = {
        key
        for item in items
        for key in item.get("indicators", {})
    }
    if "state" in found:
        return ["state"]
    return [
        *[key for key in _INDICATOR_ORDER if key in found],
        *sorted(found - set(_INDICATOR_ORDER)),
    ]


def _indicator_specs(items, columns):
    max_widths = {"target": 24}
    return [
        (
            key,
            _INDICATOR_LABELS.get(key, key.replace("_", " ").title()),
            min(
                max_widths.get(key, float("inf")),
                max(
                    len(_INDICATOR_LABELS.get(key, key.replace("_", " ").title())),
                    max(
                        (len(_display_indicator(key, item.get("indicators", {}).get(key, "—"))) for item in items),
                        default=0,
                    ),
                ),
            ),
        )
        for key in _indicator_columns(items, columns)
    ]


def _row_columns(items, include_status=True):
    import shutil

    w = shutil.get_terminal_size().columns
    if w < 80:
        status_max = max(8, int(w * 0.15))
        context_max = max(10, int(w * 0.20))
        title_max = max(20, int(w * 0.45))
    else:
        status_max, context_max, title_max = _STATUS_MAX, _CONTEXT_MAX, _TITLE_MAX

    status_col = min(max((len(i["status"]) for i in items), default=0), status_max)
    context_col = min(max((len(i["context"]) for i in items), default=0), context_max)
    title_col = min(max((len(i["title"]) for i in items), default=0), title_max)
    if not include_status:
        status_col = 0
    separator_width = 7 if include_status else 5
    title_col = max(0, title_col - max(0, status_col + context_col + title_col + separator_width - w))
    return status_col, context_col, title_col


def _visible_row_text(item, status_col, context_col, title_col, include_status=True):
    import shutil

    status = _clip(item["status"], status_col)
    context = _clip(item["context"], context_col)
    title = _clip(item["title"], title_col)
    w = shutil.get_terminal_size().columns
    separator_width = 7 if include_status else 5
    details_width = max(0, w - status_col - context_col - title_col - separator_width)
    details = _clip(item["details"], details_width) if w < 80 else item["details"]
    if include_status:
        return f"{status:<{status_col}}  {title:<{title_col}}  {context:<{context_col}}  {details} "
    return f"{title:<{title_col}}  {context:<{context_col}}  {details} "


def render_rows(items):
    """Render STATUS, TITLE, and CONTEXT with hidden action data."""
    _normalize_row_text(items)
    status_col, context_col, title_col = _row_columns(items)

    rows = []
    for item in items:
        visible = _visible_row_text(item, status_col, context_col, title_col)
        actions = item.get("actions", [])
        blob = base64.b64encode(json.dumps(actions).encode()).decode()
        hint = hint_for_actions(actions)
        rows.append(f"{visible}\t{blob}\t{hint}")
    return rows


def render_dashboard_rows(items, columns=None):
    """Render interactive rows as an aligned content-and-indicator table."""
    import shutil

    _normalize_row_text(items)
    indicator_specs = _indicator_specs(items, columns)
    width = shutil.get_terminal_size().columns
    indicator_width = (
        2 + sum(cell_width for _, _, cell_width in indicator_specs)
        + 2 * max(0, len(indicator_specs) - 1)
    )
    context_col = min(
        max((len(item["context"]) for item in items), default=0),
        _CONTEXT_MAX,
    )
    title_col = min(
        max((len(item["title"]) for item in items), default=0),
        _TITLE_MAX,
        max(0, width - context_col - indicator_width - 2),
    )
    indicator_metadata = json.dumps({
        "offset": title_col + context_col + 4,
        "columns": [(label, cell_width) for _, label, cell_width in indicator_specs],
    })

    rows = []
    for item in items:
        title = _clip(item["title"], title_col)
        context = _clip(item["context"], context_col)
        visible = f"{title:<{title_col}}  {context:<{context_col}}"
        if indicator_specs:
            indicators = item.get("indicators", {})
            indicator_cells = "  ".join(
                f"{_clip(_display_indicator(key, indicators.get(key, '—')), cell_width):<{cell_width}}"
                for key, _, cell_width in indicator_specs
            )
            visible = f"{visible}  {indicator_cells}"
        actions = item.get("actions", [])
        blob = base64.b64encode(json.dumps(actions).encode()).decode()
        keys_csv = ",".join(action["key"] for action in actions)
        hint = _dashboard_hint_for_actions(actions)
        row = f"{visible}\t{blob}\t{keys_csv}\t{hint}"
        if indicator_specs:
            row = f"{row}\t{indicator_metadata}"
        rows.append(row)
    return rows

_DEFAULT_DASHBOARD_GROUPS = (
    {
        "name": "Pull Requests",
        "match": {"kinds": ["pull_request"]},
        "columns": ["state"],
    },
    {"name": "Issues", "match": {"kinds": ["issue"]}, "columns": ["state"]},
    {"name": "Reminders", "match": {"kinds": ["reminder"]}, "columns": ["state"]},
    {"name": "Events", "match": {"kinds": ["event"]}, "columns": ["state"]},
    {"name": "Other", "fallback": True, "columns": ["state"]},
)


def _default_dashboard_groups():
    return [
        {key: dict(value) if isinstance(value, dict) else value for key, value in group.items()}
        for group in _DEFAULT_DASHBOARD_GROUPS
    ]


def _normalize_group_match(match, path, *, allow_any=False):
    fields = ("plugins", "kinds", "contexts", "contextPrefixes", "statuses", "authors")
    supported_fields = fields + ("any",) if allow_any else fields
    if not isinstance(match, dict) or set(match) - set(supported_fields):
        return None, f"{path} must contain only {', '.join(supported_fields[:-1])}, or {supported_fields[-1]}"

    normalized_match = {}
    for key in fields:
        values = match.get(key)
        if values is None:
            continue
        if not isinstance(values, list) or not values or not all(isinstance(value, str) for value in values):
            return None, f"{path}.{key} must be a non-empty list of strings"
        normalized_match[key] = list(values)

    if "any" in match:
        alternatives = match["any"]
        if not isinstance(alternatives, list) or not alternatives:
            return None, f"{path}.any must be a non-empty list of match objects"
        normalized_match["any"] = []
        for index, alternative in enumerate(alternatives, 1):
            normalized_alternative, error = _normalize_group_match(
                alternative, f"{path}.any[{index}]",
            )
            if error:
                return None, error
            normalized_match["any"].append(normalized_alternative)
    return normalized_match, None


def dashboard_auto_expand(config):
    """Whether dashboard groups open expanded (`dashboard.autoExpand`)."""
    dashboard_config = config.get("dashboard")
    if not isinstance(dashboard_config, dict):
        return False, None
    value = dashboard_config.get("autoExpand", False)
    if not isinstance(value, bool):
        return False, "dashboard.autoExpand must be true or false"
    return value, None


def dashboard_groups(config):
    dashboard_config = config.get("dashboard")
    if dashboard_config is None:
        return _default_dashboard_groups(), None
    if not isinstance(dashboard_config, dict):
        return None, "dashboard configuration must be an object"
    raw_groups = dashboard_config.get("groups")
    if raw_groups is None:
        return _default_dashboard_groups(), None
    if not isinstance(raw_groups, list) or not raw_groups:
        return None, "dashboard.groups must be a non-empty list"

    groups = []
    names = set()
    fallback_count = 0
    for index, raw_group in enumerate(raw_groups, 1):
        if not isinstance(raw_group, dict):
            return None, f"dashboard.groups[{index}] must be an object"
        if set(raw_group) - {"name", "match", "fallback", "columns"}:
            return None, f"dashboard.groups[{index}] has an unsupported field"
        name = raw_group.get("name")
        if not isinstance(name, str) or not name.strip() or "\t" in name or "\n" in name:
            return None, f"dashboard.groups[{index}].name must be a non-empty single-line string"
        name = name.strip()
        if name in names:
            return None, f"dashboard.groups contains duplicate name {name!r}"
        names.add(name)

        columns = raw_group.get("columns")
        if columns is not None and (
            not isinstance(columns, list)
            or not columns
            or not all(isinstance(column, str) and column for column in columns)
            or len(set(columns)) != len(columns)
        ):
            return None, f"dashboard.groups[{index}].columns must be a non-empty list of unique strings"

        is_fallback = raw_group.get("fallback") is True
        has_match = "match" in raw_group
        if is_fallback == has_match:
            return None, f"dashboard.groups[{index}] must declare exactly one of match or fallback"
        if is_fallback:
            fallback_count += 1
            groups.append({"name": name, "fallback": True, "columns": columns})
            continue

        normalized_match, error = _normalize_group_match(
            raw_group["match"], f"dashboard.groups[{index}].match", allow_any=True,
        )
        if error:
            return None, error
        groups.append({"name": name, "match": normalized_match, "columns": columns})

    if fallback_count != 1:
        return None, "dashboard.groups must declare exactly one fallback group"
    return groups, None


def _group_context_candidates(item):
    """Values a `contextPrefixes` rule can match.

    A source may render a shorter context for readability -- the bundled
    github plugin shows only the repository name -- while still reporting the
    provider-qualified identity as `repo`. Organization prefixes have to see
    that identity, or every item of that source falls through to a broader
    rule that also matches it.
    """
    return [
        value
        for value in (item.get("context", ""), item.get("repo", ""))
        if isinstance(value, str) and value
    ]


def _group_matches(item, match):
    context = item.get("context", "")
    if "authors" in match and not item.get("author"):
        return False
    if "contextPrefixes" in match and not any(
        candidate.startswith(prefix)
        for candidate in _group_context_candidates(item)
        for prefix in match["contextPrefixes"]
    ):
        return False
    fields = {
        "plugins": item.get("_plugin", ""),
        "kinds": item.get("kind", ""),
        "contexts": context,
        "statuses": item.get("status", ""),
        "authors": item.get("author", ""),
    }
    if not all(
        fields[key] in values
        for key, values in match.items()
        if key != "contextPrefixes" and key != "any"
    ):
        return False
    return "any" not in match or any(
        _group_matches(item, alternative) for alternative in match["any"]
    )


def _session_tool_name(tool):
    """An AoE agent name: one word, no control characters, no flag confusion."""
    return (
        isinstance(tool, str)
        and bool(tool)
        and not tool.startswith("-")
        and not any(
            char.isspace() or ord(char) < 32 or ord(char) == 127 for char in tool
        )
    )


def _contains_path(root, path):
    """Whether path is root or a descendant of it, without prefix false positives."""
    prefix = root if root.endswith(os.sep) else root + os.sep
    return path == root or path.startswith(prefix)


def _session_repo_pattern(repo):
    """An owner/name repository or an owner/* prefix, as configured."""
    if not isinstance(repo, str):
        return False
    if any(ord(char) < 32 or ord(char) == 127 for char in repo):
        return False
    return bool(re.fullmatch(r"[^\s*/]+/(?:[^\s*/]+|\*)", repo.strip()))


def session_agents(config):
    """Resolve which agent an AoE session should start per repository or directory.

    Returns (agents, error), where each agent is {"path": <absolute
    directory> | "repo": <owner>/<name> or <owner>/*, "tool": <AoE agent
    name>}. Items matching no entry keep AoE's default agent.
    """
    session_config = config.get("session") if isinstance(config, dict) else None
    if session_config is None:
        return [], None
    if not isinstance(session_config, dict):
        return None, "session configuration must be an object"
    if set(session_config) - {"agents"}:
        return None, "session has an unsupported field"
    raw_agents = session_config.get("agents")
    if raw_agents is None:
        return [], None
    if not isinstance(raw_agents, list):
        return None, "session.agents must be a list"

    agents = []
    for index, raw_agent in enumerate(raw_agents, 1):
        if not isinstance(raw_agent, dict) or set(raw_agent) not in (
            {"path", "tool"}, {"repo", "tool"},
        ):
            return None, (
                f"session.agents[{index}] must declare exactly path and tool, "
                "or exactly repo and tool"
            )
        tool = raw_agent.get("tool")
        if not _session_tool_name(tool):
            return None, f"session.agents[{index}].tool must be an agent name"
        if "repo" in raw_agent:
            repo = raw_agent.get("repo")
            if not _session_repo_pattern(repo):
                return None, (
                    f"session.agents[{index}].repo must be an owner/repo or owner/* pattern"
                )
            agents.append({"repo": repo.strip().casefold(), "tool": tool})
            continue
        path = raw_agent.get("path")
        if not isinstance(path, str) or not path.strip():
            return None, f"session.agents[{index}].path must be a non-empty string"
        agents.append({
            "path": os.path.realpath(os.path.expanduser(path.strip())),
            "tool": tool,
        })
    return agents, None


def _item_project_path(item):
    """The directory an item's AoE session would start in."""
    if item.get("_plugin") == "github":
        path = item.get("repo_project_path") or item.get("repo_path")
    else:
        path = item.get("repo_path")
    return path.strip() if isinstance(path, str) else ""


def session_agent_for_item(agents, item):
    """The agent configured for an item, or "" to keep AoE's default agent.

    A GitHub item resolves from its `repo` identity: an exact repository
    match beats an owner wildcard. Directory matching is the fallback, and
    the longest configured directory containing the item's project
    directory wins.
    """
    if not isinstance(item, dict):
        return ""
    repo = item.get("repo")
    if isinstance(repo, str):
        identity = repo.strip().casefold()
        owner, separator, name = identity.partition("/")
        if separator and owner and name:
            for agent in agents:
                if agent.get("repo") == identity:
                    return agent["tool"]
            for agent in agents:
                if agent.get("repo") == f"{owner}/*":
                    return agent["tool"]
    path = _item_project_path(item)
    if not path:
        return ""
    resolved = os.path.realpath(os.path.expanduser(path))
    directories = [
        agent for agent in agents
        if isinstance(agent.get("path"), str)
        and _contains_path(agent["path"], resolved)
    ]
    if not directories:
        return ""
    return max(directories, key=lambda agent: len(agent["path"]))["tool"]


def apply_session_agent(items, config):
    """Stamp the agent resolved for each item onto its configured session
    actions, so dispatching one can expose it as AOE_TOOL.

    An invalid session.agents configuration attaches nothing: the AoE
    worker fails the refresh rather than starting the wrong agent.
    """
    agents, error = session_agents(config)
    if error:
        return
    for item in items:
        tool = session_agent_for_item(agents, item)
        if not tool:
            continue
        for action in item.get("actions", []):
            payload = action.get("payload")
            label = action.get("label")
            if (
                isinstance(label, str)
                and label.strip().casefold() in {"session", "new session"}
                and isinstance(payload, dict)
                and "command" in payload
            ):
                payload["session_tool"] = tool


_automation_warned = False

# Per-round automation budget: the caps in force, what was already in flight
# when the round began, and what this round has started out of those budgets.
_automation_gate = {
    "maxWip": None,
    "maxWipByProvider": {},
    "maxSessions": {},
    "wip_used": 0,
    "provider_used": {},
    "rule_used": {},
    "tool_used": {},
    "warned": set(),
}


def load_automation_rules(config):
    """Validated `automation.rules`; a bad configuration disables
    automation for the run (warned once, never repeated per render).
    """
    global _automation_warned
    rules, error = automation.load_rules(
        config,
        normalize_match=lambda raw, path: _normalize_group_match(
            raw, path, allow_any=True,
        ),
    )
    if error:
        if not _automation_warned:
            _automation_warned = True
            print(
                f"attention: invalid automation configuration: {error}; automation disabled.",
                file=sys.stderr,
            )
        return []
    return rules


def load_automation_limits(config):
    """Validated `automation.maxWipByProvider` / `automation.maxSessions`.

    Returns None when the configuration is invalid, having disabled
    automation for the run -- a cap that cannot be trusted must not be
    silently ignored.
    """
    global _automation_warned
    limits, error = automation.load_limits(config)
    if error:
        if not _automation_warned:
            _automation_warned = True
            print(
                f"attention: invalid automation configuration: {error}; automation disabled.",
                file=sys.stderr,
            )
        return None
    return limits


def live_aoe_sessions():
    """Live AoE sessions, snoozed ones excluded, read once per round.

    This is the only record of work already in flight outside this process:
    `aoe list --state live --json` costs one subprocess per round, and a
    snoozed session is one the user has explicitly set aside, so it neither
    covers its item nor holds an agent slot. Any failure (no aoe, a daemon
    that will not answer, unparseable output) reads as "nothing running"
    rather than failing the refresh.
    """
    aoe_bin = os.environ.get("AOE_BIN") or "aoe"
    try:
        result = subprocess.run(
            [aoe_bin, "list", "--all", "--state", "live", "--json"],
            capture_output=True, text=True, timeout=20,
        )
        rows = json.loads(result.stdout) if result.returncode == 0 else []
    except Exception:
        rows = []
    now = datetime.now(timezone.utc)
    sessions = []
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        snoozed_until = row.get("snoozed_until")
        if isinstance(snoozed_until, str) and snoozed_until:
            try:
                wakes = datetime.fromisoformat(snoozed_until.replace("Z", "+00:00"))
            except ValueError:
                wakes = None
            if wakes is not None and wakes > now:
                continue
        sessions.append(row)
    return sessions


def _session_branch(session):
    worktree = session.get("worktree")
    branch = worktree.get("branch") if isinstance(worktree, dict) else None
    return branch.casefold() if isinstance(branch, str) and branch else ""


def item_in_live_session(item, sessions):
    """Whether a live AoE session already covers this item.

    GitHub items carry the head branch of their pull request, and an AoE
    session's worktree is cut from that same branch, so the branch name is
    the join (a session branch may still be prefixed with the owner, hence
    the suffix test). Linear sessions are titled with the issue identifier,
    which a branch may carry too. Providers with neither join never match,
    rather than guessing from titles alone.
    """
    head = item.get("head_branch")
    if isinstance(head, str) and head.strip():
        head = head.strip().casefold()
        return any(
            branch == head or branch.endswith("/" + head)
            for branch in (_session_branch(session) for session in sessions)
            if branch
        )
    if item.get("_plugin") != "linear":
        return False
    identifier = item.get("id")
    if not isinstance(identifier, str) or not identifier.strip():
        return False
    identifier = identifier.strip().casefold()
    for session in sessions:
        title = session.get("title")
        if isinstance(title, str) and identifier in title.casefold():
            return True
        if identifier in _session_branch(session):
            return True
    return False


def _automation_session_tool(item):
    """The agent this item's session will start, from `session.agents`.

    Empty when the item's provider or repository has no configured agent: the
    dispatch then falls through to AoE's own default, which automation cannot
    predict and so does not budget for.
    """
    action = _automation_session_action(item)
    if action is None:
        return ""
    tool = (action.get("payload") or {}).get("session_tool")
    return tool if isinstance(tool, str) else ""


def _automation_cap_reached(name, used, limit):
    """Whether a budget is spent, naming it once per round on stderr."""
    if limit is None or used < limit:
        return False
    if name not in _automation_gate["warned"]:
        _automation_gate["warned"].add(name)
        print(
            f"attention: not starting an automation session: {used} already in"
            f" flight and automation.{name} is {limit}.",
            file=sys.stderr,
        )
    return True


def _automation_session_action(item):
    """The item's configured session action, or None if it has none."""
    for action in item.get("actions", []):
        label = action.get("label")
        payload = action.get("payload")
        if (
            isinstance(label, str)
            and label.strip().casefold() in {"session", "new session"}
            and isinstance(payload, dict)
            and isinstance(payload.get("command"), list)
            and payload["command"]
        ):
            return action
    return None


def start_automation_session(item, message, rule):
    """Start the item's configured session action with `message` as `{input}`.

    Same command a `session` hotkey runs, minus the prompt: the input is
    forced into the background so an automated start never opens a
    terminal window or blocks the dashboard. A session action with no
    `{input}` placeholder, or one whose command resolves an empty token,
    starts nothing -- better to skip than to launch an agent with no
    instructions or in the wrong directory.

    Every budget is checked before the dispatch: the global `maxWip`, the
    item provider's `maxWipByProvider`, this rule's own `maxWip`, and the
    agent's `maxSessions`. Counters are per round as well as from existing
    state, so one round cannot exceed a budget before any of its starts are
    visible anywhere else.
    """
    gate = _automation_gate
    plugin = item.get("_plugin", "")
    tool = _automation_session_tool(item)
    if _automation_cap_reached("maxWip", gate["wip_used"], gate["maxWip"]):
        return False
    if _automation_cap_reached(
        f"maxWipByProvider.{plugin}" if plugin else "maxWipByProvider",
        gate["provider_used"].get(plugin, 0),
        gate["maxWipByProvider"].get(plugin),
    ):
        return False
    if _automation_cap_reached(
        f"rules.{rule['name']}.maxWip",
        gate["rule_used"].get(rule["name"], 0),
        rule.get("maxWip"),
    ):
        return False
    if tool and _automation_cap_reached(
        f"maxSessions.{tool}", gate["tool_used"].get(tool, 0), gate["maxSessions"].get(tool),
    ):
        return False
    action = _automation_session_action(item)
    if action is None:
        return False
    command = action["payload"]["command"]
    if not any(isinstance(token, str) and "{input}" in token for token in command):
        return False
    filled = [
        token.replace("{input}", message) if isinstance(token, str) else token
        for token in command
    ]
    if any(not isinstance(token, str) or not token for token in filled):
        return False
    payload = {
        key: value for key, value in action["payload"].items() if key != "inputs"
    }
    payload["command"] = filled
    payload["terminal"] = False
    payload["background"] = True
    # Automation runs behind `attention list`'s tab-delimited output and the
    # curses dashboard, so a dispatch's own chatter only surfaces on failure.
    output = io.StringIO()
    try:
        with contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
            started = dispatch_item_action(dict(action, payload=payload)) is not False
    except Exception as error:
        # A raising action (a missing binary in a service's PATH, say) must not
        # take down the list or dashboard that merely triggered it -- the same
        # way the keypress path reports it instead of propagating.
        started = False
        print(f"{error}", file=output)
    if not started:
        detail = output.getvalue().strip()
        print(
            "attention: automation could not start a session"
            f" for {item.get('title', '')!r}{': ' + detail if detail else ''}",
            file=sys.stderr,
        )
    else:
        gate["wip_used"] += 1
        gate["provider_used"][plugin] = gate["provider_used"].get(plugin, 0) + 1
        gate["rule_used"][rule["name"]] = gate["rule_used"].get(rule["name"], 0) + 1
        if tool:
            gate["tool_used"][tool] = gate["tool_used"].get(tool, 0) + 1
    return started


def apply_automation(items, config):
    """Fire `automation.rules` against a snapshot, then add the nudges
    still pending from earlier rounds back on top of it.
    """
    global _automation_warned
    limit, limit_error = automation.load_max_wip(config)
    if limit_error:
        if not _automation_warned:
            _automation_warned = True
            print(
                f"attention: invalid automation configuration: {limit_error}; automation disabled.",
                file=sys.stderr,
            )
        return items
    limits = load_automation_limits(config)
    if limits is None:
        return items
    rules = load_automation_rules(config)
    if not rules:
        return items
    state_path = get_automation_state_path()
    # Only items still in the list hold a slot, so a mark left behind by an
    # item that is gone (merged, closed, archived) never wedges a budget.
    wip_items = get_wip_items()
    sessions = live_aoe_sessions()

    def covered_by_session(item):
        """Whether a live AoE session is already working this item."""
        return item_in_live_session(item, sessions)

    # A budget slot is held by anything in flight: marked WIP here, or running
    # under a live session. Only the live session suppresses a dispatch -- a
    # WIP mark outlives the session that set it and nothing clears it, so
    # skipping on it would wedge a rule for that item for good.
    in_flight = [
        item for item in items
        if get_wip_item_id(item) in wip_items or covered_by_session(item)
    ]
    provider_used = {}
    for item in in_flight:
        plugin = item.get("_plugin", "")
        provider_used[plugin] = provider_used.get(plugin, 0) + 1
    # A rule's budget counts sessions it started that are still in flight; its
    # starts are keyed "<rule>|<item key>" in the fired map.
    fired = automation.fired_for(state_path)
    in_flight_keys = {get_wip_item_id(item) for item in in_flight}
    rule_used = {
        rule["name"]: sum(
            1 for key in in_flight_keys if f"{rule['name']}|{key}" in fired
        )
        for rule in rules
    }
    # Agent budgets are about the provider's capacity, so every live session of
    # that agent holds a slot -- including ones no attention item is behind.
    tool_used = {}
    for session in sessions:
        tool = session.get("tool")
        if isinstance(tool, str) and tool:
            tool_used[tool] = tool_used.get(tool, 0) + 1
    _automation_gate.update(
        maxWip=limit,
        maxWipByProvider=limits["maxWipByProvider"],
        maxSessions=limits["maxSessions"],
        wip_used=len(in_flight),
        provider_used=provider_used,
        rule_used=rule_used,
        tool_used=tool_used,
        warned=set(),
    )
    nudges = automation.evaluate(
        rules, items,
        matches=_group_matches,
        item_key=get_wip_item_id,
        start_session=start_automation_session,
        state_path=state_path,
        in_progress=covered_by_session,
    )
    if not nudges:
        return items
    failures = [item for item in items if item.get("_collector_failure")]
    visible = [item for item in items if not item.get("_collector_failure")]
    visible.extend(nudges)
    visible.sort(key=lambda item: item.get("weight", 0), reverse=True)
    return [*visible, *failures]


def _tree_order(items):
    by_identity = {
        item["identity_key"]: item
        for item in items
        if item.get("identity_key")
    }
    children = {}
    attached = set()
    for item in items:
        parent = item.get("parent_identity_key")
        if parent in by_identity and parent != item.get("identity_key"):
            children.setdefault(parent, []).append(item)
            attached.add(id(item))
    if not children:
        return items

    ordered = []
    visited = set()

    def append_item(item, prefix="", connector=""):
        marker = id(item)
        if marker in visited:
            return
        visited.add(marker)
        row = dict(item)
        if connector:
            row["title"] = f"{prefix}{connector}{item['title']}"
        ordered.append(row)
        descendants = children.get(item.get("identity_key"), [])
        descendant_prefix = prefix + (
            "   " if connector == "└─ " else "│  " if connector else ""
        )
        for index, child in enumerate(descendants):
            child_connector = "└─ " if index == len(descendants) - 1 else "├─ "
            append_item(child, descendant_prefix, child_connector)

    for item in items:
        if id(item) not in attached:
            append_item(item)
    for item in items:
        append_item(item)
    return ordered


def render_grouped_dashboard_rows(items, groups):
    grouped_items = {group["name"]: [] for group in groups}
    fallback = next(group["name"] for group in groups if group.get("fallback"))
    for item in items:
        group_name = next(
            (
                group["name"]
                for group in groups
                if "match" in group and _group_matches(item, group["match"])
            ),
            fallback,
        )
        grouped_items[group_name].append(item)
    return [
        f"{row}\t{group['name']}"
        for group in groups
        for row in render_dashboard_rows(
            _tree_order(grouped_items[group["name"]]), group.get("columns"),
        )
    ]




def build_snapshot(items_by_plugin, recently_acted=None):
    """Flatten items_by_plugin's values, merge cross-links, apply the
    age-based weight boost (created_at at least a day/three days/a week
    old gets +1/+2/+3; items with no real creation timestamp get none)
    and the recently_acted deprioritization penalty, then sort by
    weight. Extracted from build_prioritized_items() so the interactive
    dashboard's DashboardController can run the same merge/sort
    pipeline once per completed provider, not just once per full fetch.

    Pure over `items_by_plugin`: every item is shallow-copied, and each of
    its actions is copied too, before any transformation, so the caller's
    stored provider item objects are never mutated -- the dashboard
    calls this repeatedly over the same stored items every time a round
    relaunches or a new provider completes, and merge_cross_links()'s
    _absorb() writes through host["details"]/host["weight"]/
    host["actions"] would otherwise re-absorb the same guest on every
    later call, compounding the note/weight/actions each time.
    """
    failures = [
        it for plugin_items in items_by_plugin.values()
        for it in plugin_items if it.get("_collector_failure")
    ]
    items = [
        dict(it, actions=[dict(a) for a in it.get("actions", [])])
        for plugin_items in items_by_plugin.values()
        for it in plugin_items if not it.get("_collector_failure")
    ]
    items = merge_cross_links(items)

    wip_items = get_wip_items()
    for it in items:
        apply_wip_state(it, wip_items)

    now = datetime.now(timezone.utc)
    for it in items:
        age_boost = 0
        created_at = it.get("created_at", "")
        if created_at:
            try:
                created = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
                if created.tzinfo is None:
                    created = created.replace(tzinfo=timezone.utc)
                age_days = (now - created).total_seconds() / 86400
                if age_days >= 7:
                    age_boost = 3
                elif age_days >= 3:
                    age_boost = 2
                elif age_days >= 1:
                    age_boost = 1
            except (ValueError, TypeError):
                pass
        it["weight"] = it.get("weight", 0) + age_boost

    if recently_acted:
        for it in items:
            if it.get("id") in recently_acted:
                it["weight"] = max(0, it.get("weight", 0) - 20)

    items.sort(key=lambda x: x.get("weight", 0), reverse=True)
    return [*items, *failures]


def build_prioritized_items(config, recently_acted=None, apply_rules=True):
    """Fetch every configured plugin, group the results by which plugin
    produced each item, and delegate to build_snapshot() for the merge/
    age-boost/recently-acted/sort pipeline shared with the interactive
    dashboard's per-round snapshots, then apply automation rules.

    `apply_rules=False` skips the automation pass for read-only callers
    that inspect the list (`expect-keys`); automation fires actions and
    writes state, so only the display/act paths run it.
    """
    items_by_plugin = {}
    for item in fetch_all(config):
        items_by_plugin.setdefault(item.get("_plugin"), []).append(item)
    items = build_snapshot(items_by_plugin, recently_acted)
    return apply_automation(items, config) if apply_rules else items


def print_rows():
    for row in render_rows(build_prioritized_items(load_config())):
        print(row)


def dispatch_item_action(action):
    """Run a normalized source action and apply its WIP transition."""
    plugin = action["_plugin"]
    payload = action.get("payload")
    if not isinstance(payload, dict):
        raise ValueError(f"plugin '{plugin}' act() received a malformed payload: expected a dictionary, got {type(payload).__name__}")
    if plugin == automation.NUDGE_PLUGIN and payload.get("kind") == "dismiss_nudge":
        return automation.dismiss_nudge(
            payload.get("nudge_id"), get_automation_state_path(),
        )
    mod = load_plugin(plugin)
    completed = mod.act(action.get("_original_key", action.get("key", "")), payload)
    if completed is False:
        return False
    if action.get("wip") == "clear":
        unmark_wip_item(action.get("_wip_id"))
    elif action.get("wip"):
        mark_wip_item(action.get("_wip_id"))
    return True


def act(key, line):
    """Dispatch a single action against one dashboard row.
    key is the literal action key, or empty when plain Enter selected the
    row. line is the complete tab-delimited row text.
    """
    parts = line.split("\t", 1)
    if len(parts) < 2:
        print("No action bound to this row (malformed row).")
        return False
    blob = parts[1].split("\t", 1)[0]
    try:
        actions = json.loads(base64.b64decode(blob).decode())
    except Exception:
        print("No action bound to this row (malformed row).")
        return False

    valid_keys = {a["key"] for a in actions}
    resolved_key = key
    if resolved_key == "":
        primary = next((a for a in actions if a.get("primary")), None)
        if primary is None:
            return False
        resolved_key = primary["key"]

    if resolved_key not in valid_keys:
        print(f"No action bound to '{resolved_key}' for this item.")
        return False

    action = next(a for a in actions if a["key"] == resolved_key)
    try:
        return dispatch_item_action(action)
    except (KeyboardInterrupt, EOFError):
        print("\nCanceled.")
        return False
    except Exception as e:
        print(f"Action failed: {e}")
        return False



def acknowledge_action():
    try:
        input("Press Enter to return to the dashboard...")
    except EOFError:
        pass

def run_dashboard():
    """Fetch once on open, then refresh only when the user presses r."""
    config = load_config()
    groups, group_error = dashboard_groups(config)
    if group_error:
        print(f"attention: invalid dashboard.groups configuration: {group_error}; using flat dashboard.", file=sys.stderr)
    auto_expand, auto_expand_error = dashboard_auto_expand(config)
    if auto_expand_error:
        print(f"attention: invalid dashboard.autoExpand configuration: {auto_expand_error}; groups start collapsed.", file=sys.stderr)
    plugin_names = config.get("plugins", DEFAULT_PLUGINS)
    if not plugin_names:
        print("Nothing needs attention right now.")
        return

    for name in plugin_names:
        try:
            load_plugin(name)
        except Exception:
            pass

    def fetch_plugin(name):
        return fetch_plugin_items(name, config)

    if groups:
        group_names = [group["name"] for group in groups]
        presenter = dashboard.CursesGroupPresenter(
            group_names, expanded=group_names if auto_expand else (),
        )
        render_rows = lambda items: render_grouped_dashboard_rows(items, groups)
    else:
        presenter = dashboard.CursesPresenter()
        render_rows = lambda items: render_dashboard_rows(_tree_order(items))

    def build_automated_snapshot(items_by_plugin, recently_acted):
        # Idempotent: a rule records what it already fired, so re-rendering a
        # round never repeats a session start or a nudge.
        return apply_automation(
            build_snapshot(items_by_plugin, recently_acted), config,
        )

    controller = dashboard.DashboardController(
        plugin_names, presenter,
        fetch_plugin=fetch_plugin,
        on_fetch_error=collector_failure_item,
        build_snapshot=build_automated_snapshot,
        render_rows=render_rows,
        act=act,
        acknowledge_action=acknowledge_action,
    )
    try:
        found_something = controller.run()
    except (OSError, curses.error) as e:
        print(f"attention: could not start the interactive dashboard: {e}", file=sys.stderr)
        sys.exit(1)
    if not found_something:
        print("Nothing needs attention right now.")

if __name__ == "__main__":
    if len(sys.argv) > 3 and sys.argv[1] == "act":
        act(sys.argv[2], sys.argv[3])
    elif len(sys.argv) > 1 and sys.argv[1] == "expect-keys":
        print(",".join(expect_keys_for(build_prioritized_items(load_config(), apply_rules=False))))
    elif len(sys.argv) > 1 and sys.argv[1] == "list":
        print_rows()
    elif len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(USAGE)
    else:
        run_dashboard()
