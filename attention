_plugin_cache = {}

def load_plugin(name):
    """Resolve a plugin by name: a bare word (e.g. "github") loads the
    bundled sources/<name>.py next to this script; anything containing
    "/" or ending in ".py" is a direct path to a third-party module --
    nothing to register, just point at the file. Cached per name so a
    plugin is only ever imported once per process.
    """
    if name in _plugin_cache:
        return _plugin_cache[name]
    if "/" in name or name.endswith(".py"):
        path = Path(name).expanduser().resolve()
    else:
        path = Path(__file__).resolve().parent / "sources" / f"{name}.py"

    # Put the plugin's own directory on sys.path before loading it, so
    # it can `import` sibling helper modules (the bundled plugins share
    # sources/_util.py this way; a third-party plugin can do the same
    # with its own helpers).
    plugin_dir = str(path.parent)
    if plugin_dir not in sys.path:
        sys.path.insert(0, plugin_dir)

    spec = importlib.util.spec_from_file_location(f"attention_plugin_{name}", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    _plugin_cache[name] = mod
    return mod


class ActionRequired(TypedDict):
    key: str
    label: str


class Action(ActionRequired, total=False):
    primary: bool
    wip: bool | str
    payload: dict


class ItemRequired(TypedDict):
    status: str
    context: str
    title: str
    details: str
    weight: int


class Item(ItemRequired, total=False):
    id: str
    absorb_note: str
    created_at: str
    actions: list
    identity_key: str
    association_keys: list
    status_priority: int
    indicators: dict[str, str]
    kind: str
    author: str


def validate_and_normalize_item(item, name):
    """Enforce the Item/Action shape documented in PLUGINS.md on one
    item a plugin's fetch() returned: raises ValueError naming the
    plugin and the exact problem for a missing/mistyped field, and
    fills in defaults for the optional ones so callers never need
    `.get(..., default)` again.
    """
    if not isinstance(item, dict):
        raise ValueError(f"plugin '{name}' returned a malformed item: expected a dictionary, got {type(item).__name__}")

    required_item_keys = {
        "status": str,
        "context": str,
        "title": str,
        "details": str,
        "weight": int,
    }
    for key, expected_type in required_item_keys.items():
        if key not in item:
            raise ValueError(f"plugin '{name}' returned a malformed item: missing required key '{key}'")
        val = item[key]
        if expected_type is int and isinstance(val, bool):
            raise ValueError(f"plugin '{name}' returned a malformed item: '{key}' must be of type int, got bool")
        if not isinstance(val, expected_type):
            raise ValueError(f"plugin '{name}' returned a malformed item: '{key}' must be of type {expected_type.__name__}, got {type(val).__name__}")

    if "id" not in item:
        item["id"] = ""
    elif not isinstance(item["id"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'id' must be of type str, got {type(item['id']).__name__}")

    if "absorb_note" not in item:
        item["absorb_note"] = ""
    elif not isinstance(item["absorb_note"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'absorb_note' must be of type str, got {type(item['absorb_note']).__name__}")

    if "created_at" not in item:
        item["created_at"] = ""
    elif not isinstance(item["created_at"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'created_at' must be of type str, got {type(item['created_at']).__name__}")

    if "identity_key" not in item:
        item["identity_key"] = ""
    elif not isinstance(item["identity_key"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'identity_key' must be of type str, got {type(item['identity_key']).__name__}")

    if "association_keys" not in item:
        item["association_keys"] = []
    elif not isinstance(item["association_keys"], list) or not all(isinstance(key, str) for key in item["association_keys"]):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'association_keys' must be a list of strings")

    if "status_priority" not in item:
        item["status_priority"] = 0
    elif isinstance(item["status_priority"], bool) or not isinstance(item["status_priority"], int):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'status_priority' must be of type int, got {type(item['status_priority']).__name__}")

    if "indicators" not in item:
        item["indicators"] = {}
    elif (
        not isinstance(item["indicators"], dict)
        or not all(
            isinstance(key, str) and key and isinstance(value, str)
            for key, value in item["indicators"].items()
        )
    ):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'indicators' must be a mapping of non-empty strings to strings")

    if "kind" not in item:
        item["kind"] = ""
    elif not isinstance(item["kind"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'kind' must be of type str, got {type(item['kind']).__name__}")

    if "author" not in item:
        item["author"] = ""
    elif not isinstance(item["author"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'author' must be of type str, got {type(item['author']).__name__}")

    if "actions" not in item:
        item["actions"] = []
    elif not isinstance(item["actions"], list):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'actions' must be of type list, got {type(item['actions']).__name__}")

    for action in item["actions"]:
        if not isinstance(action, dict):
            raise ValueError(f"plugin '{name}' returned a malformed item: action must be a dictionary, got {type(action).__name__}")

        required_action_keys = {"key": str, "label": str}
        for key, expected_type in required_action_keys.items():
            if key not in action:
                raise ValueError(f"plugin '{name}' returned a malformed item: action missing required key '{key}'")
            val = action[key]
            if not isinstance(val, expected_type):
                raise ValueError(f"plugin '{name}' returned a malformed item: action '{key}' must be of type {expected_type.__name__}, got {type(val).__name__}")
        if not re.fullmatch(r"[A-Za-z0-9]", action["key"]):
            raise ValueError(
                f"plugin '{name}' returned a malformed item: action 'key' must be "
                "one letter or digit"
            )

        if "primary" not in action:
            action["primary"] = False
        elif not isinstance(action["primary"], bool):
            raise ValueError(f"plugin '{name}' returned a malformed item: action 'primary' must be of type bool, got {type(action['primary']).__name__}")

        if "wip" not in action:
            action["wip"] = False
        elif action["wip"] is not True and action["wip"] is not False and action["wip"] != "clear":
            raise ValueError(f"plugin '{name}' returned a malformed item: action 'wip' must be true, false, or \"clear\", got {action['wip']!r}")

        if "read" not in action:
            action["read"] = False
        elif not isinstance(action["read"], bool):
            raise ValueError(f"plugin '{name}' returned a malformed item: action 'read' must be of type bool, got {type(action['read']).__name__}")

        if "payload" not in action:
            action["payload"] = {}
        elif not isinstance(action["payload"], dict):
            raise ValueError(f"plugin '{name}' returned a malformed item: action 'payload' must be of type dict, got {type(action['payload']).__name__}")


def collector_failure_item(name, exc):
    """A visible, inert result; never include exception text or command output."""
    label = Path(name).stem if "/" in name or name.endswith(".py") else name
    label = re.sub(r"[^A-Za-z0-9_.-]", "_", label)[:60] or "unknown"
    reason = type(exc).__name__
    if isinstance(exc, OSError) and exc.errno is not None:
        import errno
        reason += f" ({errno.errorcode.get(exc.errno, 'OS error')})"
    elif isinstance(getattr(exc, "returncode", None), int):
        reason += f" (exit {exc.returncode})"
    elif isinstance(getattr(exc, "code", None), int):
        reason += f" (HTTP {exc.code})"
    return {
        "_collector_failure": True, "_plugin": name,
        "status": "FETCH FAILED", "title": f"{label} collector failed",
        "context": label, "details": reason, "weight": 0, "actions": [],
    }


def fetch_plugin_items(name, config):
    mod = load_plugin(name)
    fetched = mod.fetch(config) or []
    for item in fetched:
        validate_and_normalize_item(item, name)
    for item in fetched:
        item["_plugin"] = name
        for action in item.get("actions", []):
            action["_plugin"] = name
            action["_item_id"] = item.get("id")
    apply_session_agent(fetched, config)
    return fetched


def fetch_all(config):
    """Call every configured plugin's fetch() concurrently, tagging each
    returned action with which plugin produced it (core's own bookkeeping,
    not part of the plugin's return value) so act() later knows who to
    dispatch a pressed key to. One plugin failing (bad config, missing
    dependency, network error) never takes down the others.

    Plugins are loaded in the main thread first (load_plugin mutates
    sys.path which isn't thread-safe), then only fetch() runs in parallel.
    """
    plugin_names = config.get("plugins", DEFAULT_PLUGINS)
    if not plugin_names:
        return []

    # Pre-load all plugins in the main thread.
    for name in plugin_names:
        try:
            load_plugin(name)
        except Exception:
            pass

    def _fetch_one(name):
        try:
            return fetch_plugin_items(name, config)
        except Exception as exc:
            return [collector_failure_item(name, exc)]

    items = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(plugin_names)) as pool:
        futures = [pool.submit(_fetch_one, name) for name in plugin_names]
        for fut in futures:
            items.extend(fut.result())
    return items


def _absorb(host, guest):
    """Merge `guest` into `host`: fold one side's status into the other's
    details, boost host's weight, and splice guest's actions into host's
    action list (renamed only on an actual key collision, to the lowest
    unused bare digit -- and always labeled "(linked)" so it's visually
    obvious which
    actions reach a different, absorbed item).

    Whichever side has the higher `status_priority` (default 0) keeps its
    `status` visible on the merged row; the other side's status/details
    become a note instead. This lets a plugin whose status is the
    authoritative signal for the underlying work (e.g. Linear's workflow
    state) win over one whose status just describes process mechanics
    (e.g. a GitHub PR's review/CI state), regardless of which side ended
    up as the structural host.
    """
    if guest.get("status_priority", 0) > host.get("status_priority", 0):
        demoted_status, demoted_details = host.get("status", ""), host.get("details", "")
        host["status"] = guest.get("status", demoted_status)
        host["status_priority"] = guest.get("status_priority", 0)
        host["details"] = f"{demoted_status}: {demoted_details}" if demoted_details else demoted_status
    else:
        note = guest.get("absorb_note") or f"{guest.get('status', '')}: {guest.get('title', '')}"
        host["details"] = f"{host['details']} | {note}" if host.get("details") else note
    host["weight"] = max(host.get("weight", 0), guest.get("weight", 0)) + 5
    host["_linked_item_urls"] = list(dict.fromkeys(
        [*host.get("_linked_item_urls", []), guest.get("url"),
         *guest.get("_linked_item_urls", [])]
    ))

    host_actions = host.setdefault("actions", [])
    host_keys = {a["key"] for a in host_actions}
    for action in guest.get("actions", []):
        key = action["key"]
        new_key = key
        if new_key in host_keys:
            candidates = list("123456789")
            new_key = next((c for c in candidates if c not in host_keys), key)
        merged_action = dict(action, key=new_key, label=f"{action['label']} (linked)", primary=False, _original_key=key)
        host_actions.append(merged_action)
        host_keys.add(new_key)


def merge_cross_links(items):
    """Two generic, source-agnostic passes over every fetched item --
    see PLUGINS.md's "Cross-link merging" section for the exact rules.
    Neither pass knows or cares which plugin produced which item.
    """
    by_identity = {it["identity_key"]: it for it in items if it.get("identity_key")}
    absorbed_associations = set()
    for host in items:
        if id(host) in absorbed_associations:
            continue
        for key in host.get("association_keys", []):
            guest = by_identity.get(key)
            if guest is None or guest is host or id(guest) in absorbed_associations:
                continue
            _absorb(host, guest)
            absorbed_associations.add(id(guest))
    items = [it for it in items if id(it) not in absorbed_associations]

    # 1. ID-shaped title match (e.g. a PR title mentioning "ABC-123"
    # absorbs whichever other item has id "ABC-123").
    by_id = {it["id"].upper(): it for it in items if it.get("id")}
    absorbed_ids = set()
    for host in items:
        if id(host) in absorbed_ids:
            continue
        for token in re.findall(r"[A-Z]+-\d+", host.get("title", "").upper()):
            guest = by_id.get(token)
            if guest is None or guest is host or id(guest) in absorbed_ids:
                continue
            _absorb(host, guest)
            absorbed_ids.add(id(guest))
    items = [it for it in items if id(it) not in absorbed_ids]

    # 2. Title-substring match (e.g. a reminder titled "Prep for Team
    # Dinner" absorbs into a calendar event titled "Team Dinner").
    by_title = [(it["title"].lower().strip(), it) for it in items]
    absorbed_titles = set()
    for guest_title, guest in by_title:
        if id(guest) in absorbed_titles:
            continue
        for host_title, host in by_title:
            if host is guest or id(host) in absorbed_titles:
                continue
            if len(host_title) < 4 or host_title == "untitled":
                continue
            if host_title in guest_title:
                _absorb(host, guest)
                absorbed_titles.add(id(guest))
                break
    return [it for it in items if id(it) not in absorbed_titles]




def expect_keys_for(items):
    """Union of every action key actually present across the current
    item list -- computed fresh from what's really there, not a static
    hypothetical table, since core no longer knows the space of possible
    plugins/actions ahead of time.
    """
    keys = []
    seen = set()
    for item in items:
        for a in item.get("actions", []):
            if a["key"] not in seen:
                seen.add(a["key"])
                keys.append(a["key"])
    return keys


def _action_hint_parts(actions):
    parts = []
    for a in actions:
        parts.append(f"{a['key']} {a['label']}")
    return parts


def hint_for_actions(actions):
    """Human-readable footer hint, e.g. 'o open  s session'."""
    return "  ".join(_action_hint_parts(actions))


def _dashboard_hint_for_actions(actions):
    import shutil

    width = max(1, shutil.get_terminal_size().columns - 2)
    lines = []
    line = ""
    for part in _action_hint_parts(actions):
        if len(part) > width:
            if line:
                lines.append(line)
                line = ""
            lines.extend(part[start:start + width] for start in range(0, len(part), width))
        elif line and len(line) + 2 + len(part) > width:
            lines.append(line)
            line = part
        else:
            line = f"{line}  {part}" if line else part
    if line:
        lines.append(line)
    return "\v".join(lines)


_STATUS_MAX, _CONTEXT_MAX, _TITLE_MAX = 20, 30, 60


def _clip(text, width):
    if width <= 0:
        return ""
    return text if len(text) <= width else text[: width - 1] + "…"


def _normalize_row_text(items):
    for item in items:
        item["status"] = item.get("status", "").replace("\t", " ")
        item["context"] = item.get("context", "").replace("\t", " ")
        item["title"] = item.get("title", "").replace("\t", " ")
        item["details"] = item.get("details", "").replace("\t", " ")

