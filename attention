#!/usr/bin/env python3
"""attention -- prioritized multi-source triage dashboard, core.

Slim orchestrator: loads config, loads each configured plugin module,
merges/cross-links/sorts what they return, renders through the terminal UI,
and routes a pressed hotkey back to whichever plugin's action produced it.
Contains no source-specific logic itself -- see PLUGINS.md for the
interface a plugin implements; sources/*.py are the bundled ones.

Config: reads $XDG_CONFIG_HOME/attention/config.json (default
~/.config/attention/config.json). With no config file at all, the five
bundled plugins (calendar, reminders, github, linear, generic) all load
with their own empty defaults -- calendar/reminders/generic then
contribute nothing until configured; github/linear still work out of
the box, gated only by their own auth availability.
"""
import base64
import curses
import fcntl
import importlib.util
import json
import os
import re
import sys
import tempfile
from pathlib import Path
from datetime import datetime, timezone
import concurrent.futures
from typing import TypedDict

USAGE = """Usage: attention [COMMAND]

Commands:
  (none)         Run the interactive dashboard (default)
  list           Print the current prioritized list (raw tab-delimited format)
  expect-keys    Print the comma-joined set of declared action keys
  act KEY LINE   Dispatch a single hotkey press against one dashboard row
  -h, --help     Show this message

See PLUGINS.md for the source-plugin interface and config["plugins"].
"""

DEFAULT_PLUGINS = ["calendar", "reminders", "github", "linear", "generic"]


_WIP_STATE_FILENAME = "wip.json"
_wip_items = None


def get_wip_state_path():
    xdg_state_home = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(xdg_state_home) / "attention" / _WIP_STATE_FILENAME


def _read_wip_items():
    try:
        with open(get_wip_state_path()) as f:
            stored_items = json.load(f)
    except Exception:
        return set()
    if not isinstance(stored_items, list):
        return set()
    return {item_id for item_id in stored_items if isinstance(item_id, str)}


def get_wip_items():
    global _wip_items
    if _wip_items is None:
        _wip_items = _read_wip_items()
    return _wip_items


def _write_wip_items(mutate):
    """Locked read-modify-write of the persisted WIP set. `mutate(items)`
    edits the set in place; whatever it returns is passed back to the caller.
    """
    global _wip_items
    state_path = get_wip_state_path()
    state_path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = state_path.with_suffix(".lock")
    with open(lock_path, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        wip_items = _read_wip_items()
        result = mutate(wip_items)
        descriptor, temp_path = tempfile.mkstemp(
            dir=state_path.parent, prefix=f".{state_path.name}.", suffix=".tmp",
        )
        try:
            with os.fdopen(descriptor, "w") as f:
                json.dump(sorted(wip_items), f)
            os.replace(temp_path, state_path)
        finally:
            if os.path.exists(temp_path):
                os.unlink(temp_path)
    _wip_items = wip_items
    return result


def mark_wip_item(item_id):
    """Idempotently mark an item as work in progress (never clears it) --
    used when an action configured with "wip": true runs, so acting on the
    item flags it automatically.
    """
    if not item_id:
        return False

    def mutate(wip_items):
        if item_id in wip_items:
            return False
        wip_items.add(item_id)
        return True

    return _write_wip_items(mutate)


def unmark_wip_item(item_id):
    """Idempotently clear an item's work-in-progress mark (no-op if it was
    not marked) -- used when an action configured with "wip": "clear" runs.
    """
    if not item_id:
        return False

    def mutate(wip_items):
        if item_id not in wip_items:
            return False
        wip_items.discard(item_id)
        return True

    return _write_wip_items(mutate)


def get_wip_item_id(item):
    identifier = item.get("id") or item.get("identity_key")
    if identifier:
        return f"{item.get('_plugin', '')}:{identifier}"
    return json.dumps([
        item.get("_plugin", ""),
        item.get("context", ""),
        item.get("title", ""),
        item.get("details", ""),
    ], separators=(",", ":"))


def apply_wip_state(item, wip_items):
    """Stamp each of the item's actions with the item's WIP id (so act()
    can mark the item after a "wip": true action completes) and, when the
    item is already marked, prefix its details with a visible banner.
    """
    wip_id = get_wip_item_id(item)
    for action in item["actions"]:
        action["_wip_id"] = wip_id
    if wip_id in wip_items:
        details = item.get("details", "")
        item["details"] = f"WORK IN PROGRESS | {details}" if details else "WORK IN PROGRESS"


def get_config_path():
    xdg_config_home = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(xdg_config_home) / "attention" / "config.json"


_config_cache = None

def load_config():
    global _config_cache
    if _config_cache is None:
        try:
            with open(get_config_path()) as f:
                _config_cache = json.load(f)
        except Exception:
            _config_cache = {}
    return _config_cache


_dashboard_spec = importlib.util.spec_from_file_location(
    "dashboard", Path(__file__).resolve().parent / "dashboard.py"
)
dashboard = importlib.util.module_from_spec(_dashboard_spec)
_dashboard_spec.loader.exec_module(dashboard)

_plugin_cache = {}

def load_plugin(name):
    """Resolve a plugin by name: a bare word (e.g. "github") loads the
    bundled sources/<name>.py next to this script; anything containing
    "/" or ending in ".py" is a direct path to a third-party module --
    nothing to register, just point at the file. Cached per name so a
    plugin is only ever imported once per process.
    """
    if name in _plugin_cache:
        return _plugin_cache[name]
    if "/" in name or name.endswith(".py"):
        path = Path(name).expanduser().resolve()
    else:
        path = Path(__file__).resolve().parent / "sources" / f"{name}.py"

    # Put the plugin's own directory on sys.path before loading it, so
    # it can `import` sibling helper modules (the bundled plugins share
    # sources/_util.py this way; a third-party plugin can do the same
    # with its own helpers).
    plugin_dir = str(path.parent)
    if plugin_dir not in sys.path:
        sys.path.insert(0, plugin_dir)

    spec = importlib.util.spec_from_file_location(f"attention_plugin_{name}", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    _plugin_cache[name] = mod
    return mod


class ActionRequired(TypedDict):
    key: str
    label: str


class Action(ActionRequired, total=False):
    primary: bool
    wip: bool | str
    payload: dict


class ItemRequired(TypedDict):
    status: str
    context: str
    title: str
    details: str
    weight: int


class Item(ItemRequired, total=False):
    id: str
    absorb_note: str
    created_at: str
    actions: list
    identity_key: str
    association_keys: list
    status_priority: int
    indicators: dict[str, str]


def validate_and_normalize_item(item, name):
    """Enforce the Item/Action shape documented in PLUGINS.md on one
    item a plugin's fetch() returned: raises ValueError naming the
    plugin and the exact problem for a missing/mistyped field, and
    fills in defaults for the optional ones so callers never need
    `.get(..., default)` again.
    """
    if not isinstance(item, dict):
        raise ValueError(f"plugin '{name}' returned a malformed item: expected a dictionary, got {type(item).__name__}")

    required_item_keys = {
        "status": str,
        "context": str,
        "title": str,
        "details": str,
        "weight": int,
    }
    for key, expected_type in required_item_keys.items():
        if key not in item:
            raise ValueError(f"plugin '{name}' returned a malformed item: missing required key '{key}'")
        val = item[key]
        if expected_type is int and isinstance(val, bool):
            raise ValueError(f"plugin '{name}' returned a malformed item: '{key}' must be of type int, got bool")
        if not isinstance(val, expected_type):
            raise ValueError(f"plugin '{name}' returned a malformed item: '{key}' must be of type {expected_type.__name__}, got {type(val).__name__}")

    if "id" not in item:
        item["id"] = ""
    elif not isinstance(item["id"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'id' must be of type str, got {type(item['id']).__name__}")

    if "absorb_note" not in item:
        item["absorb_note"] = ""
    elif not isinstance(item["absorb_note"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'absorb_note' must be of type str, got {type(item['absorb_note']).__name__}")

    if "created_at" not in item:
        item["created_at"] = ""
    elif not isinstance(item["created_at"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'created_at' must be of type str, got {type(item['created_at']).__name__}")

    if "identity_key" not in item:
        item["identity_key"] = ""
    elif not isinstance(item["identity_key"], str):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'identity_key' must be of type str, got {type(item['identity_key']).__name__}")

    if "association_keys" not in item:
        item["association_keys"] = []
    elif not isinstance(item["association_keys"], list) or not all(isinstance(key, str) for key in item["association_keys"]):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'association_keys' must be a list of strings")

    if "status_priority" not in item:
        item["status_priority"] = 0
    elif isinstance(item["status_priority"], bool) or not isinstance(item["status_priority"], int):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'status_priority' must be of type int, got {type(item['status_priority']).__name__}")

    if "indicators" not in item:
        item["indicators"] = {}
    elif (
        not isinstance(item["indicators"], dict)
        or not all(
            isinstance(key, str) and key and isinstance(value, str)
            for key, value in item["indicators"].items()
        )
    ):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'indicators' must be a mapping of non-empty strings to strings")

    if "actions" not in item:
        item["actions"] = []
    elif not isinstance(item["actions"], list):
        raise ValueError(f"plugin '{name}' returned a malformed item: 'actions' must be of type list, got {type(item['actions']).__name__}")

    for action in item["actions"]:
        if not isinstance(action, dict):
            raise ValueError(f"plugin '{name}' returned a malformed item: action must be a dictionary, got {type(action).__name__}")

        required_action_keys = {"key": str, "label": str}
        for key, expected_type in required_action_keys.items():
            if key not in action:
                raise ValueError(f"plugin '{name}' returned a malformed item: action missing required key '{key}'")
            val = action[key]
            if not isinstance(val, expected_type):
                raise ValueError(f"plugin '{name}' returned a malformed item: action '{key}' must be of type {expected_type.__name__}, got {type(val).__name__}")
        if not re.fullmatch(r"[A-Za-z0-9]", action["key"]):
            raise ValueError(
                f"plugin '{name}' returned a malformed item: action 'key' must be "
                "one letter or digit"
            )

        if "primary" not in action:
            action["primary"] = False
        elif not isinstance(action["primary"], bool):
            raise ValueError(f"plugin '{name}' returned a malformed item: action 'primary' must be of type bool, got {type(action['primary']).__name__}")

        if "wip" not in action:
            action["wip"] = False
        elif action["wip"] is not True and action["wip"] is not False and action["wip"] != "clear":
            raise ValueError(f"plugin '{name}' returned a malformed item: action 'wip' must be true, false, or \"clear\", got {action['wip']!r}")

        if "payload" not in action:
            action["payload"] = {}
        elif not isinstance(action["payload"], dict):
            raise ValueError(f"plugin '{name}' returned a malformed item: action 'payload' must be of type dict, got {type(action['payload']).__name__}")


def fetch_all(config):
    """Call every configured plugin's fetch() concurrently, tagging each
    returned action with which plugin produced it (core's own bookkeeping,
    not part of the plugin's return value) so act() later knows who to
    dispatch a pressed key to. One plugin failing (bad config, missing
    dependency, network error) never takes down the others.

    Plugins are loaded in the main thread first (load_plugin mutates
    sys.path which isn't thread-safe), then only fetch() runs in parallel.
    """
    plugin_names = config.get("plugins", DEFAULT_PLUGINS)
    if not plugin_names:
        return []

    # Pre-load all plugins in the main thread.
    for name in plugin_names:
        try:
            load_plugin(name)
        except Exception:
            pass

    def _fetch_one(name):
        try:
            mod = load_plugin(name)
            fetched = mod.fetch(config) or []
        except Exception:
            return []
        try:
            for item in fetched:
                validate_and_normalize_item(item, name)
        except Exception as e:
            print(e, file=sys.stderr)
            return []
        for item in fetched:
            item["_plugin"] = name
            for action in item.get("actions", []):
                action["_plugin"] = name
                action["_item_id"] = item.get("id")
        return fetched

    items = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(plugin_names)) as pool:
        futures = [pool.submit(_fetch_one, name) for name in plugin_names]
        for fut in futures:
            items.extend(fut.result())
    return items


def _absorb(host, guest):
    """Merge `guest` into `host`: fold one side's status into the other's
    details, boost host's weight, and splice guest's actions into host's
    action list (renamed only on an actual key collision, to the lowest
    unused bare digit -- and always labeled "(linked)" so it's visually
    obvious which
    actions reach a different, absorbed item).

    Whichever side has the higher `status_priority` (default 0) keeps its
    `status` visible on the merged row; the other side's status/details
    become a note instead. This lets a plugin whose status is the
    authoritative signal for the underlying work (e.g. Linear's workflow
    state) win over one whose status just describes process mechanics
    (e.g. a GitHub PR's review/CI state), regardless of which side ended
    up as the structural host.
    """
    if guest.get("status_priority", 0) > host.get("status_priority", 0):
        demoted_status, demoted_details = host.get("status", ""), host.get("details", "")
        host["status"] = guest.get("status", demoted_status)
        host["status_priority"] = guest.get("status_priority", 0)
        host["details"] = f"{demoted_status}: {demoted_details}" if demoted_details else demoted_status
    else:
        note = guest.get("absorb_note") or f"{guest.get('status', '')}: {guest.get('title', '')}"
        host["details"] = f"{host['details']} | {note}" if host.get("details") else note
    host["weight"] = max(host.get("weight", 0), guest.get("weight", 0)) + 5

    host_actions = host.setdefault("actions", [])
    host_keys = {a["key"] for a in host_actions}
    for action in guest.get("actions", []):
        key = action["key"]
        new_key = key
        if new_key in host_keys:
            candidates = list("123456789")
            new_key = next((c for c in candidates if c not in host_keys), key)
        merged_action = dict(action, key=new_key, label=f"{action['label']} (linked)", primary=False, _original_key=key)
        host_actions.append(merged_action)
        host_keys.add(new_key)


def merge_cross_links(items):
    """Two generic, source-agnostic passes over every fetched item --
    see PLUGINS.md's "Cross-link merging" section for the exact rules.
    Neither pass knows or cares which plugin produced which item.
    """
    by_identity = {it["identity_key"]: it for it in items if it.get("identity_key")}
    absorbed_associations = set()
    for host in items:
        if id(host) in absorbed_associations:
            continue
        for key in host.get("association_keys", []):
            guest = by_identity.get(key)
            if guest is None or guest is host or id(guest) in absorbed_associations:
                continue
            _absorb(host, guest)
            absorbed_associations.add(id(guest))
    items = [it for it in items if id(it) not in absorbed_associations]

    # 1. ID-shaped title match (e.g. a PR title mentioning "ABC-123"
    # absorbs whichever other item has id "ABC-123").
    by_id = {it["id"].upper(): it for it in items if it.get("id")}
    absorbed_ids = set()
    for host in items:
        if id(host) in absorbed_ids:
            continue
        for token in re.findall(r"[A-Z]+-\d+", host.get("title", "").upper()):
            guest = by_id.get(token)
            if guest is None or guest is host or id(guest) in absorbed_ids:
                continue
            _absorb(host, guest)
            absorbed_ids.add(id(guest))
    items = [it for it in items if id(it) not in absorbed_ids]

    # 2. Title-substring match (e.g. a reminder titled "Prep for Team
    # Dinner" absorbs into a calendar event titled "Team Dinner").
    by_title = [(it["title"].lower().strip(), it) for it in items]
    absorbed_titles = set()
    for guest_title, guest in by_title:
        if id(guest) in absorbed_titles:
            continue
        for host_title, host in by_title:
            if host is guest or id(host) in absorbed_titles:
                continue
            if len(host_title) < 4 or host_title == "untitled":
                continue
            if host_title in guest_title:
                _absorb(host, guest)
                absorbed_titles.add(id(guest))
                break
    return [it for it in items if id(it) not in absorbed_titles]




def expect_keys_for(items):
    """Union of every action key actually present across the current
    item list -- computed fresh from what's really there, not a static
    hypothetical table, since core no longer knows the space of possible
    plugins/actions ahead of time.
    """
    keys = []
    seen = set()
    for item in items:
        for a in item.get("actions", []):
            if a["key"] not in seen:
                seen.add(a["key"])
                keys.append(a["key"])
    return keys


def _action_hint_parts(actions):
    parts = []
    for a in actions:
        parts.append(f"{a['key']} {a['label']}")
    return parts


def hint_for_actions(actions):
    """Human-readable footer hint, e.g. 'o open  s session'."""
    return "  ".join(_action_hint_parts(actions))


def _dashboard_hint_for_actions(actions):
    import shutil

    width = max(1, shutil.get_terminal_size().columns - 2)
    lines = []
    line = ""
    for part in _action_hint_parts(actions):
        if len(part) > width:
            if line:
                lines.append(line)
                line = ""
            lines.extend(part[start:start + width] for start in range(0, len(part), width))
        elif line and len(line) + 2 + len(part) > width:
            lines.append(line)
            line = part
        else:
            line = f"{line}  {part}" if line else part
    if line:
        lines.append(line)
    return "\v".join(lines)


_STATUS_MAX, _CONTEXT_MAX, _TITLE_MAX = 20, 30, 60


def _clip(text, width):
    if width <= 0:
        return ""
    return text if len(text) <= width else text[: width - 1] + "…"


def _normalize_row_text(items):
    for item in items:
        item["status"] = item.get("status", "").replace("\t", " ")
        item["context"] = item.get("context", "").replace("\t", " ")
        item["title"] = item.get("title", "").replace("\t", " ")
        item["details"] = item.get("details", "").replace("\t", " ")

_INDICATOR_LABELS = {
    "ci": "CI",
    "ready": "READY",
    "review": "REVIEW",
    "stacked": "STACKED",
}
_INDICATOR_ORDER = tuple(_INDICATOR_LABELS)


def _indicator_columns(items, columns):
    if columns is not None:
        return columns
    found = {
        key
        for item in items
        for key in item.get("indicators", {})
    }
    return [
        *[key for key in _INDICATOR_ORDER if key in found],
        *sorted(found - set(_INDICATOR_ORDER)),
    ]


def _indicator_specs(items, columns):
    return [
        (
            key,
            _INDICATOR_LABELS.get(key, key.replace("_", " ").upper()),
            max(
                len(_INDICATOR_LABELS.get(key, key.replace("_", " ").upper())),
                *(len(item.get("indicators", {}).get(key, "—")) for item in items),
            ),
        )
        for key in _indicator_columns(items, columns)
    ]


def _row_columns(items, include_status=True):
    import shutil

    w = shutil.get_terminal_size().columns
    if w < 80:
        status_max = max(8, int(w * 0.15))
        context_max = max(10, int(w * 0.20))
        title_max = max(20, int(w * 0.45))
    else:
        status_max, context_max, title_max = _STATUS_MAX, _CONTEXT_MAX, _TITLE_MAX

    status_col = min(max((len(i["status"]) for i in items), default=0), status_max)
    context_col = min(max((len(i["context"]) for i in items), default=0), context_max)
    title_col = min(max((len(i["title"]) for i in items), default=0), title_max)
    if not include_status:
        status_col = 0
    separator_width = 7 if include_status else 5
    title_col = max(0, title_col - max(0, status_col + context_col + title_col + separator_width - w))
    return status_col, context_col, title_col


def _visible_row_text(item, status_col, context_col, title_col, include_status=True):
    import shutil

    status = _clip(item["status"], status_col)
    context = _clip(item["context"], context_col)
    title = _clip(item["title"], title_col)
    w = shutil.get_terminal_size().columns
    separator_width = 7 if include_status else 5
    details_width = max(0, w - status_col - context_col - title_col - separator_width)
    details = _clip(item["details"], details_width) if w < 80 else item["details"]
    if include_status:
        return f"{status:<{status_col}}  {title:<{title_col}}  {context:<{context_col}}  {details} "
    return f"{title:<{title_col}}  {context:<{context_col}}  {details} "


def render_rows(items):
    """Format the (already merged, already sorted) item list for `attention
    list`: STATUS/TITLE/CONTEXT columns sized to this run's longest value
    (capped, so one outlier doesn't blow out the whole table) keep every
    row's fields lined up. Each row's hidden second field is its actions
    list, base64(JSON)-encoded (opaque and delimiter-safe, since a
    plugin's payload can be arbitrary JSON) -- act() decodes it, never
    needing to know which plugin produced the row until dispatch time.
    Row shape: STATUS  TITLE  CONTEXT  DETAILS \t<base64 actions>\tHINT

    Used only by the blocking `attention list`/`expect-keys` commands --
    byte-for-byte unchanged by the interactive dashboard's progressive
    rendering. See render_dashboard_rows() for the dashboard's own
    four-field format.
    """
    _normalize_row_text(items)
    status_col, context_col, title_col = _row_columns(items)

    rows = []
    for item in items:
        visible = _visible_row_text(item, status_col, context_col, title_col)
        actions = item.get("actions", [])
        blob = base64.b64encode(json.dumps(actions).encode()).decode()
        hint = hint_for_actions(actions)
        rows.append(f"{visible}\t{blob}\t{hint}")
    return rows


def render_dashboard_rows(items, columns=None):
    """Render interactive rows with optional shared indicator columns."""
    _normalize_row_text(items)
    status_col, context_col, title_col = _row_columns(items, include_status=False)
    indicator_specs = _indicator_specs(items, columns)
    indicator_metadata = json.dumps([
        (label, width) for _, label, width in indicator_specs
    ])

    rows = []
    for item in items:
        visible = _visible_row_text(
            item, status_col, context_col, title_col, include_status=False,
        )
        if indicator_specs:
            indicators = item.get("indicators", {})
            indicator_cells = "  ".join(
                f"{indicators.get(key, '—'):<{width}}"
                for key, _, width in indicator_specs
            )
            visible = f"{indicator_cells}  {visible}"
        actions = item.get("actions", [])
        blob = base64.b64encode(json.dumps(actions).encode()).decode()
        keys_csv = ",".join(a["key"] for a in actions)
        hint = _dashboard_hint_for_actions(actions)
        row = f"{visible}\t{blob}\t{keys_csv}\t{hint}"
        if indicator_specs:
            row = f"{row}\t{indicator_metadata}"
        rows.append(row)
    return rows

def dashboard_groups(config):
    dashboard_config = config.get("dashboard")
    if dashboard_config is None:
        return None, None
    if not isinstance(dashboard_config, dict):
        return None, "dashboard configuration must be an object"
    raw_groups = dashboard_config.get("groups")
    if raw_groups is None:
        return None, None
    if not isinstance(raw_groups, list) or not raw_groups:
        return None, "dashboard.groups must be a non-empty list"

    groups = []
    names = set()
    fallback_count = 0
    for index, raw_group in enumerate(raw_groups, 1):
        if not isinstance(raw_group, dict):
            return None, f"dashboard.groups[{index}] must be an object"
        if set(raw_group) - {"name", "match", "fallback", "columns"}:
            return None, f"dashboard.groups[{index}] has an unsupported field"
        name = raw_group.get("name")
        if not isinstance(name, str) or not name.strip() or "\t" in name or "\n" in name:
            return None, f"dashboard.groups[{index}].name must be a non-empty single-line string"
        name = name.strip()
        if name in names:
            return None, f"dashboard.groups contains duplicate name {name!r}"
        names.add(name)

        columns = raw_group.get("columns")
        if columns is not None and (
            not isinstance(columns, list)
            or not columns
            or not all(isinstance(column, str) and column for column in columns)
            or len(set(columns)) != len(columns)
        ):
            return None, f"dashboard.groups[{index}].columns must be a non-empty list of unique strings"

        is_fallback = raw_group.get("fallback") is True
        has_match = "match" in raw_group
        if is_fallback == has_match:
            return None, f"dashboard.groups[{index}] must declare exactly one of match or fallback"
        if is_fallback:
            fallback_count += 1
            groups.append({"name": name, "fallback": True, "columns": columns})
            continue

        match = raw_group["match"]
        if not isinstance(match, dict) or set(match) - {"plugins", "contexts", "contextPrefixes", "statuses"}:
            return None, f"dashboard.groups[{index}].match must contain only plugins, contexts, contextPrefixes, or statuses"
        normalized_match = {}
        for key in ("plugins", "contexts", "contextPrefixes", "statuses"):
            values = match.get(key)
            if values is None:
                continue
            if not isinstance(values, list) or not values or not all(isinstance(value, str) for value in values):
                return None, f"dashboard.groups[{index}].match.{key} must be a non-empty list of strings"
            normalized_match[key] = list(values)
        groups.append({"name": name, "match": normalized_match, "columns": columns})

    if fallback_count != 1:
        return None, "dashboard.groups must declare exactly one fallback group"
    return groups, None


def _group_matches(item, match):
    context = item.get("context", "")
    if "contextPrefixes" in match and not any(
        context.startswith(prefix) for prefix in match["contextPrefixes"]
    ):
        return False
    fields = {
        "plugins": item.get("_plugin", ""),
        "contexts": context,
        "statuses": item.get("status", ""),
    }
    return all(
        fields[key] in values
        for key, values in match.items()
        if key != "contextPrefixes"
    )


def render_grouped_dashboard_rows(items, groups):
    grouped_items = {group["name"]: [] for group in groups}
    fallback = next(group["name"] for group in groups if group.get("fallback"))
    for item in items:
        group_name = next(
            (
                group["name"]
                for group in groups
                if "match" in group and _group_matches(item, group["match"])
            ),
            fallback,
        )
        grouped_items[group_name].append(item)
    return [
        f"{row}\t{group['name']}"
        for group in groups
        for row in render_dashboard_rows(
            grouped_items[group["name"]], group.get("columns"),
        )
    ]




def build_snapshot(items_by_plugin, recently_acted=None):
    """Flatten items_by_plugin's values, merge cross-links, apply the
    age-based weight boost (created_at at least a day/three days/a week
    old gets +1/+2/+3; items with no real creation timestamp get none)
    and the recently_acted deprioritization penalty, then sort by
    weight. Extracted from build_prioritized_items() so the interactive
    dashboard's DashboardController can run the same merge/sort
    pipeline once per completed provider, not just once per full fetch.

    Pure over `items_by_plugin`: every item is shallow-copied, and each of
    its actions is copied too, before any transformation, so the caller's
    stored provider item objects are never mutated -- the dashboard
    calls this repeatedly over the same stored items every time a round
    relaunches or a new provider completes, and merge_cross_links()'s
    _absorb() writes through host["details"]/host["weight"]/
    host["actions"] would otherwise re-absorb the same guest on every
    later call, compounding the note/weight/actions each time.
    """
    items = [
        dict(it, actions=[dict(a) for a in it.get("actions", [])])
        for plugin_items in items_by_plugin.values()
        for it in plugin_items
    ]
    items = merge_cross_links(items)

    wip_items = get_wip_items()
    for it in items:
        apply_wip_state(it, wip_items)

    now = datetime.now(timezone.utc)
    for it in items:
        age_boost = 0
        created_at = it.get("created_at", "")
        if created_at:
            try:
                created = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
                if created.tzinfo is None:
                    created = created.replace(tzinfo=timezone.utc)
                age_days = (now - created).total_seconds() / 86400
                if age_days >= 7:
                    age_boost = 3
                elif age_days >= 3:
                    age_boost = 2
                elif age_days >= 1:
                    age_boost = 1
            except (ValueError, TypeError):
                pass
        it["weight"] = it.get("weight", 0) + age_boost

    if recently_acted:
        for it in items:
            if it.get("id") in recently_acted:
                it["weight"] = max(0, it.get("weight", 0) - 20)

    items.sort(key=lambda x: x.get("weight", 0), reverse=True)
    return items


def build_prioritized_items(config, recently_acted=None):
    """Fetch every configured plugin, group the results by which plugin
    produced each item, and delegate to build_snapshot() for the merge/
    age-boost/recently-acted/sort pipeline shared with the interactive
    dashboard's per-round snapshots.
    """
    items_by_plugin = {}
    for item in fetch_all(config):
        items_by_plugin.setdefault(item.get("_plugin"), []).append(item)
    return build_snapshot(items_by_plugin, recently_acted)


def print_rows():
    for row in render_rows(build_prioritized_items(load_config())):
        print(row)


def act(key, line):
    """Dispatch a single action against one dashboard row.
    `key` is the literal action key, or "" when plain Enter selected the
    row. `line` is the complete tab-delimited row text.
    """
    parts = line.split("\t", 1)
    if len(parts) < 2:
        print("No action bound to this row (malformed row).")
        return
    blob = parts[1].split("\t", 1)[0]
    try:
        actions = json.loads(base64.b64decode(blob).decode())
    except Exception:
        print("No action bound to this row (malformed row).")
        return

    valid_keys = {a["key"] for a in actions}
    resolved_key = key
    if resolved_key == "":
        primary = next((a for a in actions if a.get("primary")), None)
        if primary is None:
            return
        resolved_key = primary["key"]

    if resolved_key not in valid_keys:
        print(f"No action bound to '{resolved_key}' for this item.")
        return

    action = next(a for a in actions if a["key"] == resolved_key)
    try:
        mod = load_plugin(action["_plugin"])
        payload = action.get("payload")
        if not isinstance(payload, dict):
            raise ValueError(f"plugin '{action['_plugin']}' act() received a malformed payload: expected a dictionary, got {type(payload).__name__}")
        completed = mod.act(action.get("_original_key", resolved_key), payload)
        if completed is not False:
            if action.get("wip") == "clear":
                unmark_wip_item(action.get("_wip_id"))
            elif action.get("wip"):
                mark_wip_item(action.get("_wip_id"))
    except (KeyboardInterrupt, EOFError):
        print("\nCanceled.")
    except Exception as e:
        print(f"Action failed: {e}")


def acknowledge_action():
    try:
        input("Press Enter to return to the dashboard...")
    except EOFError:
        pass

def run_dashboard(refresh_interval=60):
    """The interactive loop: fetch every configured plugin concurrently,
    then republish a fresh recomputed snapshot to one long-lived curses
    presenter as each plugin fetch completes. It dispatches the selected
    row's action and repeats until Esc or the merged snapshot goes empty.

    The progressive-fetch, single-in-flight-round, pending-visibility,
    and selection-tracking behavior lives in
    dashboard.DashboardController and dashboard.CursesPresenter. This
    function supplies the config-bound callables that those classes need.
    """
    config = load_config()
    groups, group_error = dashboard_groups(config)
    if group_error:
        print(f"attention: invalid dashboard.groups configuration: {group_error}; using flat dashboard.", file=sys.stderr)
    plugin_names = config.get("plugins", DEFAULT_PLUGINS)
    if not plugin_names:
        print("Nothing needs attention right now.")
        return

    for name in plugin_names:
        try:
            load_plugin(name)
        except Exception:
            pass

    def fetch_plugin(name):
        try:
            mod = load_plugin(name)
            fetched = mod.fetch(config) or []
        except Exception:
            return []
        try:
            for item in fetched:
                validate_and_normalize_item(item, name)
        except Exception as e:
            print(e, file=sys.stderr)
            return []
        for item in fetched:
            item["_plugin"] = name
            for action in item.get("actions", []):
                action["_plugin"] = name
                action["_item_id"] = item.get("id")
        return fetched

    if groups:
        presenter = dashboard.CursesGroupPresenter([group["name"] for group in groups])
        render_rows = lambda items: render_grouped_dashboard_rows(items, groups)
    else:
        presenter = dashboard.CursesPresenter()
        render_rows = render_dashboard_rows

    controller = dashboard.DashboardController(
        plugin_names, presenter,
        fetch_plugin=fetch_plugin,
        build_snapshot=build_snapshot,
        render_rows=render_rows,
        act=act,
        acknowledge_action=acknowledge_action,
    )
    try:
        found_something = controller.run(refresh_interval)
    except (OSError, curses.error) as e:
        print(f"attention: could not start the interactive dashboard: {e}", file=sys.stderr)
        sys.exit(1)
    if not found_something:
        print("Nothing needs attention right now.")


if __name__ == "__main__":
    if len(sys.argv) > 3 and sys.argv[1] == "act":
        act(sys.argv[2], sys.argv[3])
    elif len(sys.argv) > 1 and sys.argv[1] == "expect-keys":
        print(",".join(expect_keys_for(build_prioritized_items(load_config()))))
    elif len(sys.argv) > 1 and sys.argv[1] == "list":
        print_rows()
    elif len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(USAGE)
    else:
        run_dashboard()
